# Copy to .env for local development (npm run dev)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (npm run db:up starts a matching instance via docker compose)
DATABASE_URL=postgres://workspace:workspace@localhost:5432/workspace
DATABASE_SSL=false

# Redis is optional. Set it to fan out realtime updates between several server instances.
REDIS_URL=redis://localhost:6379

# REQUIRED in production: at least 32 random characters (openssl rand -base64 48)
JWT_SECRET=dev-only-insecure-secret-change-me
# Set to false only when serving over plain http outside localhost
# COOKIE_SECURE=true
# Extra allowed WebSocket origins, comma separated (same-origin is always allowed)
# ALLOWED_ORIGINS=https://my-domain.com
